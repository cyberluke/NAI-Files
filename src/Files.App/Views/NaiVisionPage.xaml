<Page
	x:Class="Files.App.Views.NaiVisionPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:local="using:Files.App.Views">
	<Grid Padding="24" RowSpacing="12">
		<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
		<StackPanel Spacing="6">
			<TextBlock Text="{helpers:ResourceString Name=NaiVisionTitle}" Style="{StaticResource TitleTextBlockStyle}" />
			<TextBlock Text="{helpers:ResourceString Name=NaiVisionDescription}" TextWrapping="Wrap" />
		</StackPanel>
		<Grid Grid.Row="1" ColumnSpacing="8">
			<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
			<TextBox x:Name="FolderBox" IsReadOnly="True" Header="{helpers:ResourceString Name=NaiVisionFolder}" />
			<Button Grid.Column="1" Content="{helpers:ResourceString Name=NaiChooseFolder}" Click="ChooseFolder_Click" VerticalAlignment="Bottom" />
		</Grid>
		<Grid Grid.Row="2" ColumnSpacing="8">
			<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
			<AutoSuggestBox x:Name="SearchBox" AutomationProperties.AutomationId="NaiVisionSearch" PlaceholderText="{helpers:ResourceString Name=NaiVisionSearchHint}" TextChanged="SearchBox_TextChanged" QueryIcon="Find" />
			<CheckBox x:Name="AllCached" Grid.Column="1" Content="{helpers:ResourceString Name=NaiVisionAllCache}" Checked="ScopeChanged" Unchecked="ScopeChanged" />
			<ComboBox x:Name="TagBox" Grid.Column="2" MinWidth="160" MaxWidth="240" PlaceholderText="{helpers:ResourceString Name=NaiVisionTags}" SelectionChanged="TagBox_SelectionChanged" />
		</Grid>
		<StackPanel Grid.Row="3" Spacing="8">
			<VariableSizedWrapGrid Orientation="Horizontal" ItemHeight="46" ItemWidth="210" MaximumRowsOrColumns="4">
				<Button x:Name="MultilingualButton" AutomationProperties.AutomationId="NaiVisionTranslate" Content="{helpers:ResourceString Name=NaiVisionTranslate}" Click="Multilingual_Click" />
				<Button Content="{helpers:ResourceString Name=NaiVisionSaveLens}" Click="SaveLens_Click" />
				<Button Content="{helpers:ResourceString Name=NaiVisionDuplicates}" Click="CachedDuplicates_Click" />
				<Button Content="{helpers:ResourceString Name=NaiWorkspaceTitle}" Click="Workbench_Click" />
			</VariableSizedWrapGrid>
			<StackPanel Orientation="Horizontal" Spacing="8">
				<ComboBox x:Name="LensBox" MinWidth="220" PlaceholderText="{helpers:ResourceString Name=NaiVisionLenses}" />
				<Button Content="{helpers:ResourceString Name=NaiVisionLoadLens}" Click="LoadLens_Click" />
				<Button Content="{helpers:ResourceString Name=NaiWorkspaceForget}" Click="ForgetLens_Click" />
			</StackPanel>
			<TextBlock x:Name="QueryInterpretation" TextWrapping="Wrap" />
			<Expander x:Name="AnalysisTools" Header="{helpers:ResourceString Name=NaiVisionAnalyze}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
				<StackPanel Spacing="8">
					<ComboBox x:Name="ModelBox" Header="{helpers:ResourceString Name=NaiAiModel}" PlaceholderText="{helpers:ResourceString Name=NaiVisionChooseModel}" HorizontalAlignment="Stretch" DropDownOpened="ModelBox_DropDownOpened" SelectionChanged="ModelBox_SelectionChanged" />
					<CheckBox x:Name="AnalysisConsent" HorizontalContentAlignment="Stretch" Checked="ConsentChanged" Unchecked="ConsentChanged">
						<TextBlock Text="{helpers:ResourceString Name=NaiVisionConsent}" TextWrapping="Wrap" />
					</CheckBox>
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Button x:Name="AnalyzeButton" Content="{helpers:ResourceString Name=NaiVisionAnalyze}" Style="{StaticResource AccentButtonStyle}" Click="Analyze_Click" IsEnabled="False" />
						<Button x:Name="CancelAnalysis" Content="{helpers:ResourceString Name=Cancel}" Click="Cancel_Click" IsEnabled="False" />
					</StackPanel>
				</StackPanel>
			</Expander>
			<ProgressBar x:Name="AnalysisProgress" Visibility="Collapsed" />
			<TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
		</StackPanel>
		<ListView x:Name="Gallery" AutomationProperties.AutomationId="NaiVisionGallery" Grid.Row="4" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="Gallery_ItemClick">
			<ListView.ItemTemplate>
				<DataTemplate x:DataType="local:NaiVisionRow">
					<Grid Padding="8" ColumnSpacing="16" Margin="0,0,0,8">
						<Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
						<Image Source="{x:Bind Thumbnail}" Width="240" Height="130" Stretch="Uniform" />
						<StackPanel Grid.Column="1" Spacing="6">
							<TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
							<TextBlock Text="{x:Bind Entry.Caption}" TextWrapping="Wrap" />
							<ItemsControl ItemsSource="{x:Bind Entry.Tags}">
								<ItemsControl.ItemsPanel><ItemsPanelTemplate><VariableSizedWrapGrid Orientation="Horizontal" ItemHeight="34" MaximumRowsOrColumns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="x:String">
										<Button Content="{x:Bind}" Tag="{x:Bind}" Margin="0,0,6,4" Padding="10,3" CornerRadius="14" Click="TagBadge_Click" />
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock Text="{x:Bind Provenance}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
							<TextBlock Text="{x:Bind Explanation}" TextWrapping="Wrap" />
							<Button Content="{helpers:ResourceString Name=NaiVisionRelated}" Tag="{x:Bind Entry}" Click="Related_Click" />
						</StackPanel>
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>
		</ListView>
	</Grid>
</Page>
