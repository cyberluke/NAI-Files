<Page
	x:Class="Files.App.Views.NaiEmailPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:local="using:Files.App.Views">
	<Grid Padding="24" RowSpacing="12">
		<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
		<StackPanel Spacing="6"><TextBlock Text="{helpers:ResourceString Name=NaiEmailTitle}" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="{helpers:ResourceString Name=NaiEmailDescription}" TextWrapping="Wrap"/></StackPanel>
		<VariableSizedWrapGrid Grid.Row="1" Orientation="Horizontal" ItemHeight="44" ItemWidth="190" MaximumRowsOrColumns="5">
			<Button Content="{helpers:ResourceString Name=NaiEmailInbox}" Tag="naiemail://inbox" Click="Owner_Click"/>
			<Button Content="{helpers:ResourceString Name=NaiEmailAttachments}" Tag="naiemail://attachments" Click="Owner_Click"/>
			<Button Content="{helpers:ResourceString Name=NaiEmailCalendar}" Tag="naiemail://calendar" Click="Owner_Click"/>
			<Button Content="{helpers:ResourceString Name=NaiEmailTasks}" Tag="naiemail://tasks" Click="Owner_Click"/>
			<Button x:Name="RefreshButton" Content="{helpers:ResourceString Name=NaiRuntimeRefresh}" Click="Refresh_Click"/>
		</VariableSizedWrapGrid>
		<StackPanel Grid.Row="2" Spacing="6"><ProgressRing x:Name="LoadingRing" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left"/><TextBlock x:Name="SummaryText" TextWrapping="Wrap"/><TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel>
		<ComboBox x:Name="ViewBox" Grid.Row="3" SelectionChanged="View_Changed"/>
		<ListView x:Name="Rows" Grid.Row="4" IsItemClickEnabled="True" ItemClick="Row_Click" AutomationProperties.AutomationId="NaiEmailOverviewRows">
			<ListView.ItemTemplate><DataTemplate x:DataType="local:NaiWorkspaceRow"><StackPanel Padding="8" Spacing="4"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate>
		</ListView>
	</Grid>
</Page>
