		<selectors:PulseFeedTemplateSelector
			x:Key="PulseFeedTemplateSelector"
			AudioTemplate="{StaticResource PulseAudioTemplate}"
			DocumentTemplate="{StaticResource PulseDocumentTemplate}"
			GenericTemplate="{StaticResource PulseGenericTemplate}"
			ImageTemplate="{StaticResource PulseImageTemplate}"
			MarkdownTemplate="{StaticResource PulseMarkdownTemplate}"
			VideoTemplate="{StaticResource PulseVideoTemplate}" />

		<!--  One day of the feed  -->
		<DataTemplate x:Key="PulseSectionTemplate" x:DataType="pulse:PulseSection">
			<pulseuc:PulseSectionView Section="{x:Bind}" />
		</DataTemplate>

		<!--  Filter chips  -->
		<Style
			x:Key="PulseChipStyle"
			BasedOn="{StaticResource DefaultToggleButtonStyle}"
			TargetType="ToggleButton">
			<Setter Property="Padding" Value="12,4" />
			<Setter Property="MinHeight" Value="28" />
			<Setter Property="CornerRadius" Value="14" />
			<Setter Property="FontSize" Value="12" />
		</Style>
	</local:BaseGroupableLayoutPage.Resources>

	<Grid x:Name="RootGrid" ContextFlyout="{x:Bind BaseContextMenuFlyout}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Hidden list: keeps selection/rename/commands plumbing of the base layout without rendering. Kept Visible
		(zero-sized, transparent, not focusable) so the Selector raises SelectionChanged for programmatic changes.  -->
		<ListView
			x:Name="FileList"
			Width="0"
			Height="0"
			HorizontalAlignment="Left"
			VerticalAlignment="Top"
			IsHitTestVisible="False"
			IsTabStop="False"
			Opacity="0"
			PreviewKeyDown="FileList_PreviewKeyDown"
			SelectionChanged="FileList_SelectionChanged"
			SelectionMode="Extended" />

		<!--  Pulse · All · Photos · Videos · Audio · Markdown · Docs  -->
		<StackPanel
			Grid.Row="0"
			x:Name="FilterChips"
			Padding="12,8,12,4"
			Orientation="Horizontal"
			Spacing="6">
			<ToggleButton
				Click="FilterChip_Click"
				Content="{helpers:ResourceString Name=PulseFilterAll}"
				IsChecked="{x:Bind IsAllFilter, Mode=OneWay}"
				Style="{StaticResource PulseChipStyle}"
				Tag="All" />
			<ToggleButton
				Click="FilterChip_Click"
				Content="{helpers:ResourceString Name=Pictures}"
				IsChecked="{x:Bind IsPhotosFilter, Mode=OneWay}"
				Style="{StaticResource PulseChipStyle}"
				Tag="Photos" />
			<ToggleButton
				Click="FilterChip_Click"
				Content="{helpers:ResourceString Name=Videos}"
				IsChecked="{x:Bind IsVideosFilter, Mode=OneWay}"
				Style="{StaticResource PulseChipStyle}"
				Tag="Videos" />
			<ToggleButton
				Click="FilterChip_Click"
				Content="{helpers:ResourceString Name=Music}"
				IsChecked="{x:Bind IsAudioFilter, Mode=OneWay}"
				Style="{StaticResource PulseChipStyle}"
				Tag="Audio" />
			<ToggleButton
				Click="FilterChip_Click"
				Content="{helpers:ResourceString Name=PulseFilterMarkdown}"
				IsChecked="{x:Bind IsMarkdownFilter, Mode=OneWay}"
				Style="{StaticResource PulseChipStyle}"
				Tag="Markdown" />
			<ToggleButton
				Click="FilterChip_Click"
				Content="{helpers:ResourceString Name=Documents}"
				IsChecked="{x:Bind IsDocumentsFilter, Mode=OneWay}"
				Style="{StaticResource PulseChipStyle}"
				Tag="Documents" />
			<ToggleButton
				Click="FilterChip_Click"
				Content="{helpers:ResourceString Name=PulseFilterArchives}"
				IsChecked="{x:Bind IsArchivesFilter, Mode=OneWay}"
				Style="{StaticResource PulseChipStyle}"
				Tag="Archives" />
		</StackPanel>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<!--  Empty Indicator  -->
			<uc:FolderEmptyIndicator
				Grid.ColumnSpan="2"
				Margin="0,125,0,0"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				Canvas.ZIndex="0"
				EmptyTextType="{x:Bind ParentShellPageInstance.ShellViewModel.EmptyTextType, Mode=OneWay}" />

			<!--  Location Unavailable Indicator  -->
			<uc:LocationUnavailableIndicator
				Title="{x:Bind ParentShellPageInstance.ShellViewModel.LocationUnavailableTitle, Mode=OneWay}"
				Grid.ColumnSpan="2"
				MaxWidth="400"
				Margin="24,125,24,0"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				Canvas.ZIndex="0"
				Glyph="{x:Bind ParentShellPageInstance.ShellViewModel.LocationUnavailableGlyph, Mode=OneWay}"
				Message="{x:Bind ParentShellPageInstance.ShellViewModel.LocationUnavailableMessage, Mode=OneWay}"
				Visibility="{x:Bind ParentShellPageInstance.ShellViewModel.IsLocationUnavailable, Mode=OneWay}" />

			<!--  Invalid Item Name Tip  -->
			<TeachingTip
				x:Name="FileNameTeachingTip"
				CloseButtonContent="{helpers:ResourceString Name=OK}"
				PreferredPlacement="Auto"
				Subtitle="{helpers:ResourceString Name=FileNameTeachingTip/Subtitle}"
				Visibility="Collapsed" />

			<!--  Satisfies the base class contract only; Pulse drives its own day grouping inside the feed  -->
			<SemanticZoom
				x:Name="RootPulseZoom"
				Grid.Column="0"
				CanChangeViews="False"
				IsTabStop="False"
				Visibility="Collapsed">
				<SemanticZoom.ZoomedInView>
					<ListView IsTabStop="False" />
				</SemanticZoom.ZoomedInView>
				<SemanticZoom.ZoomedOutView>
					<ListView IsTabStop="False" />
				</SemanticZoom.ZoomedOutView>
			</SemanticZoom>

			<!--  Feed: one gallery per day, stacked vertically  -->
			<ScrollViewer
				x:Name="FeedScroller"
				Grid.Column="0"
				Padding="12,0,24,12"
				AllowDrop="{x:Bind InstanceViewModel.IsPageTypeSearchResults, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
				DragOver="ItemsLayout_DragOver"
				Drop="ItemsLayout_Drop"
				HorizontalScrollMode="Disabled"
				IsTabStop="True"
				PreviewKeyDown="Feed_PreviewKeyDown"
				UseSystemFocusVisuals="False"
				VerticalScrollBarVisibility="Auto"
				Visibility="{x:Bind FolderSettings.IsLayoutModeChanging, Mode=OneWay, Converter={StaticResource NegatedBoolToVisibilityConverter}}">
				<ItemsRepeater
					x:Name="SectionsRepeater"
					ElementClearing="SectionsRepeater_ElementClearing"
					ElementPrepared="SectionsRepeater_ElementPrepared"
					ItemTemplate="{StaticResource PulseSectionTemplate}"
					Loaded="SectionsRepeater_Loaded">
					<ItemsRepeater.Layout>
						<StackLayout Orientation="Vertical" Spacing="6" />
					</ItemsRepeater.Layout>
				</ItemsRepeater>
			</ScrollViewer>

			<!--  Time rail  -->
			<pulseuc:PulseTimeRail
				x:Name="TimeRail"
				Grid.Column="1"
				DayRequested="TimeRail_DayRequested" />
		</Grid>

		<!--  Rubber-band selection rectangle (Explorer parity): drawn over the whole page while the
		user drags on empty space. Never hit-testable, so it cannot intercept any pointer input. The
		canvas itself stays visible so pointer math against it is always valid; only the rect toggles.  -->
		<Canvas
			x:Name="MarqueeCanvas"
			Grid.RowSpan="2"
			Canvas.ZIndex="50"
			IsHitTestVisible="False">
			<Border
				x:Name="MarqueeRect"
				BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
				BorderThickness="1"
				Background="{ThemeResource AccentFillColorDefaultBrush}"
				Opacity="0.22"
				Visibility="Collapsed" />
		</Canvas>
	</Grid>
</local:BaseGroupableLayoutPage>