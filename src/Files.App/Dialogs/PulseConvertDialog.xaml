<ContentDialog
	x:Class="Files.App.Dialogs.PulseConvertDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	x:Name="ConvertDialog"
	Title="{helpers:ResourceString Name=PulseConvertDialogTitle}"
	CloseButtonText="{helpers:ResourceString Name=PulseTrimCancel}"
	CornerRadius="{StaticResource OverlayCornerRadius}"
	DefaultButton="Primary"
	HighContrastAdjustment="None"
	MaxWidth="560"
	PrimaryButtonClick="PrimaryButton_Click"
	PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
	PrimaryButtonText="{helpers:ResourceString Name=PulseConvert}"
	RequestedTheme="{x:Bind RootAppElement.RequestedTheme, Mode=OneWay}"
	Style="{StaticResource DefaultContentDialogStyle}"
	mc:Ignorable="d">

	<Grid RowSpacing="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Source file  -->
		<StackPanel Grid.Row="0" Orientation="Vertical" Spacing="2">
			<TextBlock
				x:Name="FileNameText"
				FontSize="13"
				FontWeight="SemiBold"
				TextTrimming="CharacterEllipsis"
				TextWrapping="NoWrap" />
			<TextBlock
				x:Name="SourceInfoText"
				FontSize="11"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{helpers:ResourceString Name=PulseTrimSourceInfo}" />
		</StackPanel>

		<!--  Output type (video sources only): audio track or video  -->
		<ComboBox
			x:Name="OutputTypeComboBox"
			Grid.Row="1"
			MaxWidth="220"
			HorizontalAlignment="Left"
			SelectionChanged="OutputTypeComboBox_SelectionChanged"
			Visibility="Collapsed">
			<ComboBoxItem Content="{helpers:ResourceString Name=PulseTrimModeAudio}" />
			<ComboBoxItem Content="{helpers:ResourceString Name=PulseConvertToVideo}" />
		</ComboBox>

		<!--  Format  -->
		<Grid Grid.Row="2" ColumnSpacing="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<TextBlock
				Grid.Column="0"
				VerticalAlignment="Center"
				FontSize="12"
				Text="{helpers:ResourceString Name=PulseConvertFormat}" />
			<ComboBox
				x:Name="FormatComboBox"
				Grid.Column="1"
				MaxWidth="260"
				HorizontalAlignment="Left"
				SelectionChanged="FormatComboBox_SelectionChanged">
				<ComboBoxItem Content="MP3" />
				<ComboBoxItem Content="M4A (AAC)" />
				<ComboBoxItem Content="WAV" />
				<ComboBoxItem Content="OGG" />
				<ComboBoxItem Content="FLAC" />
				<ComboBoxItem Content="OPUS" />
			</ComboBox>
		</Grid>

		<!--  Quality (lossy image formats)  -->
		<Grid
			x:Name="QualityRow"
			Grid.Row="3"
			ColumnSpacing="10"
			Visibility="Collapsed">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock
				Grid.Column="0"
				VerticalAlignment="Center"
				FontSize="12"
				Text="{helpers:ResourceString Name=PulseConvertQuality}" />
			<Slider
				x:Name="QualitySlider"
				Grid.Column="1"
				VerticalAlignment="Center"
				Minimum="1"
				Maximum="100"
				StepFrequency="1"
				Value="80"
				ValueChanged="QualitySlider_ValueChanged" />
			<TextBlock
				x:Name="QualityText"
				Grid.Column="2"
				VerticalAlignment="Center"
				MinWidth="36"
				FontFamily="Consolas"
				FontSize="12"
				Text="80" />
		</Grid>

		<!--  Progress + status  -->
		<Grid Grid.Row="4" ColumnSpacing="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock
				x:Name="StatusText"
				Grid.Column="0"
				VerticalAlignment="Center"
				FontSize="12"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				TextWrapping="Wrap" IsTextSelectionEnabled="True" />
			<ProgressRing
				x:Name="ProgressRing"
				Grid.Column="1"
				Width="22"
				Height="22"
				IsActive="False"
				Maximum="100" />
		</Grid>
	</Grid>
</ContentDialog>
