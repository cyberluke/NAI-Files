<ContentDialog
	x:Class="Files.App.Dialogs.PulseTrimDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	x:Name="TrimDialog"
	Title="{helpers:ResourceString Name=PulseTrimDialogTitle}"
	CloseButtonText="{helpers:ResourceString Name=PulseTrimCancel}"
	CornerRadius="{StaticResource OverlayCornerRadius}"
	DefaultButton="Primary"
	HighContrastAdjustment="None"
	MaxWidth="820"
	PrimaryButtonClick="PrimaryButton_Click"
	PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
	PrimaryButtonText="{helpers:ResourceString Name=PulseTrimExport}"
	RequestedTheme="{x:Bind RootAppElement.RequestedTheme, Mode=OneWay}"
	Style="{StaticResource DefaultContentDialogStyle}"
	mc:Ignorable="d">

	<Grid MinWidth="660" RowSpacing="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Source file + length  -->
		<StackPanel Grid.Row="0" Orientation="Vertical" Spacing="2">
			<TextBlock
				x:Name="FileNameText"
				FontSize="13"
				FontWeight="SemiBold"
				TextTrimming="CharacterEllipsis"
				TextWrapping="NoWrap" />
			<TextBlock
				x:Name="SourceDurationText"
				FontSize="11"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{helpers:ResourceString Name=PulseTrimSourceInfo}" />
			<MediaPlayerElement x:Name="VideoPreview" Height="210" Visibility="Collapsed"
				AreTransportControlsEnabled="False" AutoPlay="False" />
		</StackPanel>

		<!--  Waveform with selection region  -->
		<Border
			Grid.Row="1"
			Background="#120F2E"
			CornerRadius="8">
			<Grid
				x:Name="WaveformHost"
				Height="132"
				PointerMoved="WaveformHost_PointerMoved"
				PointerPressed="WaveformHost_PointerPressed"
				PointerReleased="WaveformHost_PointerReleased">
				<Image
					x:Name="WaveformImage"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					Stretch="Fill"
					Visibility="Collapsed" />

				<!--  Selection chrome: dimmed outside, accented box + playhead inside  -->
				<Canvas
					x:Name="SelectionCanvas"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					IsHitTestVisible="False">
					<Rectangle
						x:Name="LeftDimRect"
						Canvas.ZIndex="1"
						Fill="#A6000000" />
					<Rectangle
						x:Name="RightDimRect"
						Canvas.ZIndex="1"
						Fill="#A6000000" />
					<Border
						x:Name="SelectionBox"
						Canvas.ZIndex="2"
						Background="#22FFFFFF"
						BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
						BorderThickness="1.5" />
					<Rectangle
						x:Name="PlayedOverlay"
						Canvas.ZIndex="3"
						Fill="#55FFFFFF" />
					<Rectangle
						x:Name="PlayheadLine"
						Canvas.ZIndex="4"
						Width="2"
						Fill="{ThemeResource AccentFillColorDefaultBrush}" />
				</Canvas>

				<!--  Analyzing state  -->
				<StackPanel
					x:Name="AnalyzingPanel"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Orientation="Horizontal"
					Spacing="10">
					<ProgressRing
						x:Name="AnalyzingRing"
						Width="20"
						Height="20"
						IsActive="True" />
					<TextBlock
						VerticalAlignment="Center"
						Foreground="White"
						FontSize="12"
						Text="{helpers:ResourceString Name=PulseTrimAnalyzing}" />
				</StackPanel>

				<TextBlock
					x:Name="UnavailableText"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Foreground="White"
					FontSize="12"
					Text="{helpers:ResourceString Name=PulseTrimUnavailable}"
					Visibility="Collapsed" />
			</Grid>
		</Border>

		<!--  Start / end sliders  -->
		<Grid Grid.Row="2" ColumnSpacing="10" RowSpacing="6">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<TextBlock
				Grid.Row="0"
				Grid.Column="0"
				VerticalAlignment="Center"
				Width="46"
				FontSize="12"
				Text="{helpers:ResourceString Name=PulseTrimStart}" />
			<Slider
				x:Name="StartSlider"
				Grid.Row="0"
				Grid.Column="1"
				VerticalAlignment="Center"
				StepFrequency="0.05"
				ValueChanged="StartSlider_ValueChanged" />
			<TextBlock
				x:Name="StartTimeText"
				Grid.Row="0"
				Grid.Column="2"
				VerticalAlignment="Center"
				MinWidth="64"
				FontFamily="Consolas"
				FontSize="12"
				TextAlignment="Right" />

			<TextBlock
				Grid.Row="1"
				Grid.Column="0"
				VerticalAlignment="Center"
				Width="46"
				FontSize="12"
				Text="{helpers:ResourceString Name=PulseTrimEnd}" />
			<Slider
				x:Name="EndSlider"
				Grid.Row="1"
				Grid.Column="1"
				VerticalAlignment="Center"
				StepFrequency="0.05"
				ValueChanged="EndSlider_ValueChanged" />
			<TextBlock
				x:Name="EndTimeText"
				Grid.Row="1"
				Grid.Column="2"
				VerticalAlignment="Center"
				MinWidth="64"
				FontFamily="Consolas"
				FontSize="12"
				TextAlignment="Right" />
		</Grid>

		<!--  Transport: preview with loop  -->
		<Grid Grid.Row="3" ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Button
				x:Name="PlayPauseButton"
				Grid.Column="0"
				Width="36"
				Height="36"
				Padding="0"
				Click="PlayPauseButton_Click"
				CornerRadius="18">
				<FontIcon x:Name="PlayPauseGlyph" FontSize="14" Glyph="&#xE768;" />
			</Button>
			<Button
				x:Name="StopButton"
				Grid.Column="1"
				Width="32"
				Height="32"
				Padding="0"
				Click="StopButton_Click"
				CornerRadius="16">
				<FontIcon FontSize="11" Glyph="&#xE71A;" />
			</Button>
			<ToggleSwitch
				x:Name="LoopToggle"
				Grid.Column="2"
				VerticalAlignment="Center"
				MinWidth="0"
				OffContent="{helpers:ResourceString Name=PulseTrimLoop}"
				OnContent="{helpers:ResourceString Name=PulseTrimLoop}" />
			<TextBlock
				x:Name="PositionText"
				Grid.Column="4"
				VerticalAlignment="Center"
				FontFamily="Consolas"
				FontSize="12"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
		</Grid>

		<!--  Output: clip type + format  -->
		<Grid Grid.Row="4" ColumnSpacing="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<ComboBox
				x:Name="OutputModeComboBox"
				Grid.Column="0"
				MinWidth="130"
				SelectionChanged="OutputModeComboBox_SelectionChanged"
				Visibility="Collapsed">
				<ComboBoxItem Content="{helpers:ResourceString Name=PulseTrimModeAudio}" />
				<ComboBoxItem Content="{helpers:ResourceString Name=PulseTrimModeVideo}" />
			</ComboBox>
			<ComboBox
				x:Name="FormatComboBox"
				Grid.Column="1"
				MinWidth="130"
				SelectedIndex="0">
				<ComboBoxItem Content="MP3" />
				<ComboBoxItem Content="M4A (AAC)" />
				<ComboBoxItem Content="WAV" />
				<ComboBoxItem Content="OGG" />
				<ComboBoxItem Content="FLAC" />
				<ComboBoxItem Content="OPUS" />
			</ComboBox>
			<ComboBox
				x:Name="VideoFormatComboBox"
				Grid.Column="1"
				MinWidth="130"
				SelectedIndex="0"
				Visibility="Collapsed">
				<ComboBoxItem Content="MP4 (H.264 + AAC)" />
				<ComboBoxItem Content="WebM (VP9 + Opus)" />
				<ComboBoxItem Content="MKV (H.264 + Opus)" />
				<ComboBoxItem Content="MOV (H.264 + AAC)" />
			</ComboBox>
		</Grid>

		<!--  Audio effects (audio clips only)  -->
		<Grid
			x:Name="EffectsRow"
			Grid.Row="5"
			ColumnSpacing="12">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<ToggleSwitch
				x:Name="NormalizeToggle"
				Grid.Column="0"
				VerticalAlignment="Center"
				MinWidth="0"
				OffContent="{helpers:ResourceString Name=PulseTrimNormalize}"
				OnContent="{helpers:ResourceString Name=PulseTrimNormalize}" />
			<TextBlock
				Grid.Column="1"
				VerticalAlignment="Center"
				FontSize="12"
				Text="{helpers:ResourceString Name=PulseTrimSpeed}" />
			<Slider
				x:Name="SpeedSlider"
				Grid.Column="2"
				VerticalAlignment="Center"
				Minimum="0.5"
				Maximum="2"
				StepFrequency="0.05"
				Value="1"
				ValueChanged="SpeedSlider_ValueChanged" />
			<TextBlock
				x:Name="SpeedText"
				Grid.Column="3"
				VerticalAlignment="Center"
				MinWidth="44"
				FontFamily="Consolas"
				FontSize="12"
				Text="1.00x" />
			<TextBlock
				Grid.Column="4"
				VerticalAlignment="Center"
				FontSize="12"
				Text="{helpers:ResourceString Name=PulseTrimFadeIn}" />
			<NumberBox
				x:Name="FadeInBox"
				Grid.Column="5"
				Width="64"
				Minimum="0"
				Maximum="30"
				SmallChange="0.5"
				Value="0" />
			<TextBlock
				Grid.Column="6"
				VerticalAlignment="Center"
				FontSize="12"
				Text="{helpers:ResourceString Name=PulseTrimFadeOut}" />
			<NumberBox
				x:Name="FadeOutBox"
				Grid.Column="7"
				Width="64"
				Minimum="0"
				Maximum="30"
				SmallChange="0.5"
				Value="0" />
		</Grid>

		<!--  Export: progress + status  -->
		<Grid Grid.Row="6" ColumnSpacing="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<TextBlock
				x:Name="ExportStatusText"
				Grid.Column="0"
				VerticalAlignment="Center"
				FontSize="12"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				TextWrapping="Wrap" IsTextSelectionEnabled="True" />
			<ProgressRing
				x:Name="ExportRing"
				Grid.Column="1"
				Width="22"
				Height="22"
				IsActive="False"
				Maximum="100" />
		</Grid>
	</Grid>
</ContentDialog>
