<ContentDialog
	x:Class="Files.App.Dialogs.PulseVideoToolDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	x:Name="VideoToolDialog"
	Title="{helpers:ResourceString Name=PulseVideoDialogTitle}"
	CloseButtonText="{helpers:ResourceString Name=PulseTrimCancel}"
	CornerRadius="{StaticResource OverlayCornerRadius}"
	HighContrastAdjustment="None"
	MaxWidth="780"
	RequestedTheme="{x:Bind RootAppElement.RequestedTheme, Mode=OneWay}"
	Style="{StaticResource DefaultContentDialogStyle}"
	mc:Ignorable="d">

	<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
	<Grid RowSpacing="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!--  Source file  -->
		<StackPanel Grid.Row="0" Orientation="Vertical" Spacing="2">
			<TextBlock
				x:Name="FileNameText"
				FontSize="13"
				FontWeight="SemiBold"
				TextTrimming="CharacterEllipsis"
				TextWrapping="NoWrap" />
			<TextBlock
				x:Name="SourceInfoText"
				FontSize="11"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
		</StackPanel>

		<!--  Extract a single frame  -->
		<Border
			Grid.Row="1"
			Padding="12"
			Background="{ThemeResource LayerFillColorAltBrush}"
			CornerRadius="8">
			<StackPanel Spacing="8">
				<TextBlock
					FontSize="12"
					FontWeight="SemiBold"
					Text="{helpers:ResourceString Name=PulseVideoExtractFrame}" />
				<Grid ColumnSpacing="10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Slider
						x:Name="FrameSlider"
						Grid.Column="0"
						VerticalAlignment="Center"
						StepFrequency="0.05"
						ValueChanged="FrameSlider_ValueChanged" />
					<TextBlock
						x:Name="FrameTimeText"
						Grid.Column="1"
						VerticalAlignment="Center"
						MinWidth="56"
						FontFamily="Consolas"
						FontSize="12" />
					<ComboBox
						x:Name="FrameFormatComboBox"
						Grid.Column="2"
						MinWidth="90"
						SelectedIndex="0">
						<ComboBoxItem Content="PNG" />
						<ComboBoxItem Content="JPG" />
						<ComboBoxItem Content="WebP" />
					</ComboBox>
					<Button
						x:Name="ExtractButton"
						Grid.Column="3"
						Click="ExtractButton_Click">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<FontIcon FontSize="12" Glyph="&#xE7B5;" />
							<TextBlock Text="{helpers:ResourceString Name=PulseVideoExtract}" />
						</StackPanel>
					</Button>
				</Grid>
				<Image
					x:Name="FramePreview"
					MaxHeight="180"
					HorizontalAlignment="Left"
					Stretch="Uniform"
					Visibility="Collapsed" />
			</StackPanel>
		</Border>

		<!--  Create an animated GIF from a segment  -->
		<Border
			Grid.Row="2"
			Padding="12"
			Background="{ThemeResource LayerFillColorAltBrush}"
			CornerRadius="8">
			<StackPanel Spacing="8">
				<TextBlock
					FontSize="12"
					FontWeight="SemiBold"
					Text="{helpers:ResourceString Name=PulseVideoCreateGif}" />
				<Grid ColumnSpacing="10" RowSpacing="6">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<TextBlock
						Grid.Row="0"
						Grid.Column="0"
						VerticalAlignment="Center"
						Width="40"
						FontSize="12"
						Text="{helpers:ResourceString Name=PulseTrimStart}" />
					<Slider
						x:Name="GifStartSlider"
						Grid.Row="0"
						Grid.Column="1"
						VerticalAlignment="Center"
						StepFrequency="0.05"
						ValueChanged="GifStartSlider_ValueChanged" />
					<TextBlock
						x:Name="GifStartTimeText"
						Grid.Row="0"
						Grid.Column="2"
						VerticalAlignment="Center"
						MinWidth="56"
						FontFamily="Consolas"
						FontSize="12" />

					<TextBlock
						Grid.Row="1"
						Grid.Column="0"
						VerticalAlignment="Center"
						Width="40"
						FontSize="12"
						Text="{helpers:ResourceString Name=PulseTrimEnd}" />
					<Slider
						x:Name="GifEndSlider"
						Grid.Row="1"
						Grid.Column="1"
						VerticalAlignment="Center"
						StepFrequency="0.05"
						ValueChanged="GifEndSlider_ValueChanged" />
					<TextBlock
						x:Name="GifEndTimeText"
						Grid.Row="1"
						Grid.Column="2"
						VerticalAlignment="Center"
						MinWidth="56"
						FontFamily="Consolas"
						FontSize="12" />
				</Grid>
				<Grid ColumnSpacing="10">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock
						Grid.Column="0"
						VerticalAlignment="Center"
						FontSize="12"
						Text="{helpers:ResourceString Name=PulseVideoGifFps}" />
					<NumberBox
						x:Name="FpsBox"
						Grid.Column="1"
						Width="64"
						Minimum="5"
						Maximum="30"
						SmallChange="1"
						Value="12" />
					<TextBlock
						Grid.Column="2"
						VerticalAlignment="Center"
						FontSize="12"
						Text="{helpers:ResourceString Name=PulseVideoGifWidth}" />
					<NumberBox
						x:Name="WidthBox"
						Grid.Column="3"
						Width="72"
						Minimum="80"
						Maximum="1280"
						SmallChange="10"
						Value="320" />
					<Button
						x:Name="CreateGifButton"
						Grid.Column="5"
						Click="CreateGifButton_Click">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<FontIcon FontSize="12" Glyph="&#xE7C3;" />
							<TextBlock Text="{helpers:ResourceString Name=PulseVideoCreate}" />
						</StackPanel>
					</Button>
				</Grid>
				<Image
					x:Name="GifPreview"
					MaxHeight="180"
					HorizontalAlignment="Left"
					Stretch="Uniform"
					Visibility="Collapsed" />
			</StackPanel>
		</Border>

		<!--  Progress + status  -->
		<Grid Grid.Row="3" ColumnSpacing="10">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBlock
				x:Name="StatusText"
				Grid.Column="0"
				VerticalAlignment="Center"
				FontSize="12"
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				TextWrapping="Wrap" IsTextSelectionEnabled="True" />
			<ProgressRing
				x:Name="ProgressRing"
				Grid.Column="1"
				Width="22"
				Height="22"
				IsActive="False"
				Maximum="100" />
		</Grid>
	</Grid>
	</ScrollViewer>
</ContentDialog>
