<Application
	x:Class="Files.App.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:uc="using:Files.App.UserControls">

	<Application.Resources>
		<ResourceDictionary>

			<x:Boolean x:Key="App.ScrollInertiaEnabled">True</x:Boolean>

			<!--  Fix caption buttons background  -->
			<SolidColorBrush x:Key="WindowCaptionBackground" Color="Transparent" />
			<SolidColorBrush x:Key="WindowCaptionBackgroundDisabled" Color="Transparent" />

			<!--  Workaround for https://github.com/microsoft/microsoft-ui-xaml/issues/5441  -->
			<x:Double x:Key="MediaTransportControlsMinWidth">50</x:Double>

			<!--  Workaround for an issue where the shadow was showing on the tab control  -->
			<x:Double x:Key="TabViewShadowDepth">0</x:Double>

			<CornerRadius x:Key="GridViewThumbnailCornerRadius">2</CornerRadius>
			<CornerRadius x:Key="DetailsLayoutThumbnailCornerRadius">2</CornerRadius>

			<!--  Workaround for upstream issue #13078  -->
			<Style TargetType="FlyoutPresenter">
				<Setter Target="HighContrastAdjustment" Value="None" />
				<Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
			</Style>

			<Style TargetType="MenuFlyoutPresenter">
				<Setter Target="HighContrastAdjustment" Value="None" />
			</Style>

			<!--  Context menu primary command buttons: transparent, with hover/pressed driven by the menu-item brushes via the template's own visual states  -->
			<Style x:Key="PrimaryCommandButtonStyle" TargetType="Button">
				<Setter Property="Background" Value="Transparent" />
				<Setter Property="BorderThickness" Value="0" />
				<Setter Property="Width" Value="38" />
				<Setter Property="Height" Value="38" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="CornerRadius" Value="4" />
				<Setter Property="HorizontalContentAlignment" Value="Center" />
				<Setter Property="VerticalContentAlignment" Value="Center" />
				<Setter Property="UseSystemFocusVisuals" Value="True" />
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="Button">
							<Grid
								x:Name="Root"
								Background="{TemplateBinding Background}"
								CornerRadius="{TemplateBinding CornerRadius}">
								<ContentPresenter
									HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									Content="{TemplateBinding Content}" />
								<VisualStateManager.VisualStateGroups>
									<VisualStateGroup x:Name="CommonStates">
										<VisualState x:Name="Normal" />
										<VisualState x:Name="PointerOver">
											<VisualState.Setters>
												<Setter Target="Root.Background" Value="{ThemeResource MenuFlyoutItemBackgroundPointerOver}" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="Pressed">
											<VisualState.Setters>
												<Setter Target="Root.Background" Value="{ThemeResource MenuFlyoutItemBackgroundPressed}" />
											</VisualState.Setters>
										</VisualState>
										<VisualState x:Name="Disabled">
											<VisualState.Setters>
												<Setter Target="Root.Opacity" Value="0.4" />
											</VisualState.Setters>
										</VisualState>
									</VisualStateGroup>
								</VisualStateManager.VisualStateGroups>
							</Grid>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<ControlTemplate x:Key="PrimaryCommandMenuFlyoutItemTemplate" TargetType="MenuFlyoutItem">
				<ContentPresenter Margin="4,2" Content="{TemplateBinding Tag}" />
			</ControlTemplate>

			<!--  Workaround for upstream issue #12026  -->
			<Style BasedOn="{StaticResource DefaultMenuFlyoutItemStyle}" TargetType="MenuFlyoutItem">
				<Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
			</Style>

			<!--  Workaround for upstream issue #12026  -->
			<Style BasedOn="{StaticResource DefaultToggleMenuFlyoutItemStyle}" TargetType="ToggleMenuFlyoutItem">
				<Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
			</Style>

			<!--  Workaround for upstream issue #12026  -->
			<Style BasedOn="{StaticResource DefaultMenuFlyoutSubItemStyle}" TargetType="MenuFlyoutSubItem">
				<Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
			</Style>

			<Style BasedOn="{StaticResource DefaultComboBoxStyle}" TargetType="uc:ComboBoxEx" />

			<Style TargetType="ScrollViewer">
				<Setter Property="IsScrollInertiaEnabled" Value="{ThemeResource App.ScrollInertiaEnabled}" />
			</Style>

			<ResourceDictionary.MergedDictionaries>
				<XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
				<ResourceDictionary Source="ms-appx:///Files.App.Controls/Themes/Generic.xaml" />

				<!--  Styles for the custom icons  -->
				<ResourceDictionary Source="ms-appx:///Styles/PathIcons.xaml" />
				<ResourceDictionary Source="ms-appx:///Styles/TextBlockStyles.xaml" />
				<ResourceDictionary Source="ms-appx:///Styles/MenuFlyoutSubItemWithImageStyle.xaml" />
				<ResourceDictionary Source="ms-appx:///Styles/MenuFlyoutSubItemWithThemedIconStyle.xaml" />
				<ResourceDictionary>
					<ResourceDictionary.ThemeDictionaries>
						<ResourceDictionary x:Key="Light">
							<SolidColorBrush x:Key="App.Theme.BackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.AddressBar.BackgroundBrush" Color="{StaticResource LayerOnMicaBaseAltFillColorDefault}" />
							<SolidColorBrush x:Key="App.Theme.Toolbar.BackgroundBrush" Color="{StaticResource CardBackgroundFillColorSecondary}" />
							<SolidColorBrush x:Key="App.Theme.Sidebar.BackgroundBrush" Color="{StaticResource LayerOnMicaBaseAltFillColorDefault}" />
							<SolidColorBrush x:Key="App.Theme.FileArea.BackgroundBrush" Color="#C0FCFCFC" />
							<SolidColorBrush x:Key="App.Theme.FileArea.SecondaryBackgroundBrush" Color="{StaticResource CardBackgroundFillColorSecondary}" />
							<SolidColorBrush x:Key="App.Theme.InfoPane.BackgroundBrush" Color="{StaticResource CardBackgroundFillColorSecondary}" />

							<SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="{StaticResource SubtleFillColorTransparent}" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource LayerOnMicaBaseAltFillColorDefault}" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="{StaticResource SubtleFillColorTertiary}" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{StaticResource SubtleFillColorSecondary}" />

							<Color x:Key="App.Theme.FillColorAttention">#0070CB</Color>
							<SolidColorBrush x:Key="App.Theme.FillColorAttentionBrush" Color="{StaticResource App.Theme.FillColorAttention}" />
							<SolidColorBrush x:Key="App.Theme.CardBackgroundFillColorTertiaryBrush" Color="#FFFFFFFF" />

							<!--  NAI search shell (mirrors NAI OS Apps launcher search lane)  -->
							<Color x:Key="App.Theme.Nai.Lavender">#8D7CFF</Color>
							<Color x:Key="App.Theme.Nai.Magenta">#FF5D8F</Color>
							<Color x:Key="App.Theme.Nai.Orange">#FF9A4D</Color>
							<Color x:Key="App.Theme.Nai.Cyan">#4DEBFF</Color>
							<SolidColorBrush x:Key="App.Theme.Nai.LavenderBrush" Color="{StaticResource App.Theme.Nai.Lavender}" />
							<SolidColorBrush x:Key="App.Theme.Nai.MagentaBrush" Color="{StaticResource App.Theme.Nai.Magenta}" />
							<SolidColorBrush x:Key="App.Theme.Nai.OrangeBrush" Color="{StaticResource App.Theme.Nai.Orange}" />
							<SolidColorBrush x:Key="App.Theme.Nai.CyanBrush" Color="{StaticResource App.Theme.Nai.Cyan}" />
							<LinearGradientBrush x:Key="App.Theme.Nai.UnderlineActiveBrush" StartPoint="0,0.5" EndPoint="1,0.5">
								<GradientStop Offset="0" Color="{StaticResource App.Theme.Nai.Lavender}" />
								<GradientStop Offset="0.5" Color="{StaticResource App.Theme.Nai.Magenta}" />
								<GradientStop Offset="1" Color="{StaticResource App.Theme.Nai.Orange}" />
							</LinearGradientBrush>
							<LinearGradientBrush x:Key="App.Theme.Nai.UnderlineQueryBrush" StartPoint="0,0.5" EndPoint="1,0.5">
								<GradientStop Offset="0" Color="{StaticResource App.Theme.Nai.Cyan}" />
								<GradientStop Offset="0.5" Color="{StaticResource App.Theme.Nai.Lavender}" />
								<GradientStop Offset="1" Color="{StaticResource App.Theme.Nai.Magenta}" />
							</LinearGradientBrush>
							<LinearGradientBrush x:Key="App.Theme.Nai.SweepBrush" StartPoint="0,0.5" EndPoint="1,0.5">
								<GradientStop Offset="0" Color="#00FFFFFF" />
								<GradientStop Offset="0.45" Color="#E6FFFFFF" />
								<GradientStop Offset="0.55" Color="#E6FFFFFF" />
								<GradientStop Offset="1" Color="#00FFFFFF" />
							</LinearGradientBrush>
							<LinearGradientBrush x:Key="App.Theme.Nai.SearchShellBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
								<GradientStop Offset="0" Color="#0D000000" />
								<GradientStop Offset="1" Color="#03000000" />
							</LinearGradientBrush>
							<SolidColorBrush x:Key="App.Theme.Nai.SearchShellBorderBrush" Color="#1F000000" />
							<SolidColorBrush x:Key="App.Theme.Nai.SearchShellFocusBorderBrush" Color="#998D7CFF" />
							<SolidColorBrush x:Key="App.Theme.Nai.SearchShellFocusRingBrush" Color="#598D7CFF" />
							<SolidColorBrush x:Key="App.Theme.Nai.UnderlineBaseBrush" Color="#1F000000" />
							<SolidColorBrush x:Key="App.Theme.Nai.TextBrush" Color="#1A000000" />
							<SolidColorBrush x:Key="App.Theme.Nai.TextMutedBrush" Color="#99000000" />
							<RadialGradientBrush x:Key="App.Theme.Nai.ModeActiveChipBrush">
								<RadialGradientBrush.GradientStops>
									<GradientStop Offset="0" Color="#66FF5D8F" />
									<GradientStop Offset="0.55" Color="#24FF5D8F" />
									<GradientStop Offset="1" Color="#00FF5D8F" />
								</RadialGradientBrush.GradientStops>
							</RadialGradientBrush>
						</ResourceDictionary>
						<ResourceDictionary x:Key="Dark">
							<SolidColorBrush x:Key="App.Theme.BackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.AddressBar.BackgroundBrush" Color="{StaticResource LayerOnMicaBaseAltFillColorDefault}" />
							<SolidColorBrush x:Key="App.Theme.Toolbar.BackgroundBrush" Color="{StaticResource CardBackgroundFillColorSecondary}" />
							<SolidColorBrush x:Key="App.Theme.Sidebar.BackgroundBrush" Color="{StaticResource LayerOnMicaBaseAltFillColorDefault}" />
							<SolidColorBrush x:Key="App.Theme.FileArea.BackgroundBrush" Color="{StaticResource CardBackgroundFillColorDefault}" />
							<SolidColorBrush x:Key="App.Theme.FileArea.SecondaryBackgroundBrush" Color="{StaticResource CardBackgroundFillColorSecondary}" />
							<SolidColorBrush x:Key="App.Theme.InfoPane.BackgroundBrush" Color="{StaticResource CardBackgroundFillColorSecondary}" />

							<SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="{StaticResource SubtleFillColorTransparent}" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource LayerOnMicaBaseAltFillColorDefault}" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="{StaticResource SubtleFillColorTertiary}" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{StaticResource SubtleFillColorSecondary}" />

							<Color x:Key="App.Theme.FillColorAttention">#50C0FF</Color>
							<SolidColorBrush x:Key="App.Theme.FillColorAttentionBrush" Color="{StaticResource App.Theme.FillColorAttention}" />
							<SolidColorBrush x:Key="App.Theme.CardBackgroundFillColorTertiaryBrush" Color="#12FFFFFF" />

							<!--  NAI search shell (mirrors NAI OS Apps launcher search lane)  -->
							<Color x:Key="App.Theme.Nai.Lavender">#8D7CFF</Color>
							<Color x:Key="App.Theme.Nai.Magenta">#FF5D8F</Color>
							<Color x:Key="App.Theme.Nai.Orange">#FF9A4D</Color>
							<Color x:Key="App.Theme.Nai.Cyan">#4DEBFF</Color>
							<SolidColorBrush x:Key="App.Theme.Nai.LavenderBrush" Color="{StaticResource App.Theme.Nai.Lavender}" />
							<SolidColorBrush x:Key="App.Theme.Nai.MagentaBrush" Color="{StaticResource App.Theme.Nai.Magenta}" />
							<SolidColorBrush x:Key="App.Theme.Nai.OrangeBrush" Color="{StaticResource App.Theme.Nai.Orange}" />
							<SolidColorBrush x:Key="App.Theme.Nai.CyanBrush" Color="{StaticResource App.Theme.Nai.Cyan}" />
							<LinearGradientBrush x:Key="App.Theme.Nai.UnderlineActiveBrush" StartPoint="0,0.5" EndPoint="1,0.5">
								<GradientStop Offset="0" Color="{StaticResource App.Theme.Nai.Lavender}" />
								<GradientStop Offset="0.5" Color="{StaticResource App.Theme.Nai.Magenta}" />
								<GradientStop Offset="1" Color="{StaticResource App.Theme.Nai.Orange}" />
							</LinearGradientBrush>
							<LinearGradientBrush x:Key="App.Theme.Nai.UnderlineQueryBrush" StartPoint="0,0.5" EndPoint="1,0.5">
								<GradientStop Offset="0" Color="{StaticResource App.Theme.Nai.Cyan}" />
								<GradientStop Offset="0.5" Color="{StaticResource App.Theme.Nai.Lavender}" />
								<GradientStop Offset="1" Color="{StaticResource App.Theme.Nai.Magenta}" />
							</LinearGradientBrush>
							<LinearGradientBrush x:Key="App.Theme.Nai.SweepBrush" StartPoint="0,0.5" EndPoint="1,0.5">
								<GradientStop Offset="0" Color="#00FFFFFF" />
								<GradientStop Offset="0.45" Color="#E6FFFFFF" />
								<GradientStop Offset="0.55" Color="#E6FFFFFF" />
								<GradientStop Offset="1" Color="#00FFFFFF" />
							</LinearGradientBrush>
							<LinearGradientBrush x:Key="App.Theme.Nai.SearchShellBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
								<GradientStop Offset="0" Color="#0DFFFFFF" />
								<GradientStop Offset="1" Color="#03FFFFFF" />
							</LinearGradientBrush>
							<SolidColorBrush x:Key="App.Theme.Nai.SearchShellBorderBrush" Color="#1AECEBF4" />
							<SolidColorBrush x:Key="App.Theme.Nai.SearchShellFocusBorderBrush" Color="#998D7CFF" />
							<SolidColorBrush x:Key="App.Theme.Nai.SearchShellFocusRingBrush" Color="#598D7CFF" />
							<SolidColorBrush x:Key="App.Theme.Nai.UnderlineBaseBrush" Color="#12FFFFFF" />
							<SolidColorBrush x:Key="App.Theme.Nai.TextBrush" Color="#F3ECEBF4" />
							<SolidColorBrush x:Key="App.Theme.Nai.TextMutedBrush" Color="#A6A09DB4" />
							<RadialGradientBrush x:Key="App.Theme.Nai.ModeActiveChipBrush">
								<RadialGradientBrush.GradientStops>
									<GradientStop Offset="0" Color="#66FF5D8F" />
									<GradientStop Offset="0.55" Color="#24FF5D8F" />
									<GradientStop Offset="1" Color="#00FF5D8F" />
								</RadialGradientBrush.GradientStops>
							</RadialGradientBrush>
						</ResourceDictionary>
						<ResourceDictionary x:Key="HighContrast">
							<SolidColorBrush x:Key="App.Theme.BackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.AddressBar.BackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.Toolbar.BackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.Sidebar.BackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.FileArea.BackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.FileArea.SecondaryBackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.InfoPane.BackgroundBrush" Color="Transparent" />

							<SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="{StaticResource SystemColorWindowColor}" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource SystemColorHighlightColor}" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="{StaticResource SystemColorHighlightColor}" />
							<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{StaticResource SystemColorHighlightColor}" />

							<Color x:Key="App.Theme.FillColorAttention">#50C0FF</Color>
							<SolidColorBrush x:Key="App.Theme.FillColorAttentionBrush" Color="{StaticResource App.Theme.FillColorAttention}" />
							<SolidColorBrush x:Key="App.Theme.CardBackgroundFillColorTertiaryBrush" Color="{StaticResource SystemColorWindowColor}" />

							<!--  NAI search shell (mirrors NAI OS Apps launcher search lane)  -->
							<Color x:Key="App.Theme.Nai.Lavender">#8D7CFF</Color>
							<Color x:Key="App.Theme.Nai.Magenta">#FF5D8F</Color>
							<Color x:Key="App.Theme.Nai.Orange">#FF9A4D</Color>
							<Color x:Key="App.Theme.Nai.Cyan">#4DEBFF</Color>
							<SolidColorBrush x:Key="App.Theme.Nai.LavenderBrush" Color="{StaticResource App.Theme.Nai.Lavender}" />
							<SolidColorBrush x:Key="App.Theme.Nai.MagentaBrush" Color="{StaticResource App.Theme.Nai.Magenta}" />
							<SolidColorBrush x:Key="App.Theme.Nai.OrangeBrush" Color="{StaticResource App.Theme.Nai.Orange}" />
							<SolidColorBrush x:Key="App.Theme.Nai.CyanBrush" Color="{StaticResource App.Theme.Nai.Cyan}" />
							<LinearGradientBrush x:Key="App.Theme.Nai.UnderlineActiveBrush" StartPoint="0,0.5" EndPoint="1,0.5">
								<GradientStop Offset="0" Color="{StaticResource App.Theme.Nai.Lavender}" />
								<GradientStop Offset="0.5" Color="{StaticResource App.Theme.Nai.Magenta}" />
								<GradientStop Offset="1" Color="{StaticResource App.Theme.Nai.Orange}" />
							</LinearGradientBrush>
							<LinearGradientBrush x:Key="App.Theme.Nai.UnderlineQueryBrush" StartPoint="0,0.5" EndPoint="1,0.5">
								<GradientStop Offset="0" Color="{StaticResource App.Theme.Nai.Cyan}" />
								<GradientStop Offset="0.5" Color="{StaticResource App.Theme.Nai.Lavender}" />
								<GradientStop Offset="1" Color="{StaticResource App.Theme.Nai.Magenta}" />
							</LinearGradientBrush>
							<LinearGradientBrush x:Key="App.Theme.Nai.SweepBrush" StartPoint="0,0.5" EndPoint="1,0.5">
								<GradientStop Offset="0" Color="#00FFFFFF" />
								<GradientStop Offset="0.45" Color="#E6FFFFFF" />
								<GradientStop Offset="0.55" Color="#E6FFFFFF" />
								<GradientStop Offset="1" Color="#00FFFFFF" />
							</LinearGradientBrush>
							<SolidColorBrush x:Key="App.Theme.Nai.SearchShellBackgroundBrush" Color="Transparent" />
							<SolidColorBrush x:Key="App.Theme.Nai.SearchShellBorderBrush" Color="{StaticResource SystemColorWindowTextColor}" />
							<SolidColorBrush x:Key="App.Theme.Nai.SearchShellFocusBorderBrush" Color="{StaticResource SystemColorHighlightColor}" />
							<SolidColorBrush x:Key="App.Theme.Nai.SearchShellFocusRingBrush" Color="{StaticResource SystemColorHighlightColor}" />
							<SolidColorBrush x:Key="App.Theme.Nai.UnderlineBaseBrush" Color="{StaticResource SystemColorWindowTextColor}" />
							<SolidColorBrush x:Key="App.Theme.Nai.TextBrush" Color="{StaticResource SystemColorWindowTextColor}" />
							<SolidColorBrush x:Key="App.Theme.Nai.TextMutedBrush" Color="{StaticResource SystemColorGrayTextColor}" />
							<SolidColorBrush x:Key="App.Theme.Nai.ModeActiveChipBrush" Color="{StaticResource SystemColorHighlightColor}" />
						</ResourceDictionary>
					</ResourceDictionary.ThemeDictionaries>
				</ResourceDictionary>
			</ResourceDictionary.MergedDictionaries>

		</ResourceDictionary>
	</Application.Resources>
</Application>
