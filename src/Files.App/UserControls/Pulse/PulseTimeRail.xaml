<UserControl
	x:Class="Files.App.UserControls.Pulse.PulseTimeRail"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Width="96"
	AutomationProperties.Name="{helpers:ResourceString Name=PulseTimeRail}"
	Background="Transparent"
	IsTabStop="True"
	KeyDown="Rail_KeyDown"
	PointerCanceled="Rail_PointerReleased"
	PointerCaptureLost="Rail_PointerReleased"
	PointerEntered="Rail_PointerEntered"
	PointerExited="Rail_PointerExited"
	PointerMoved="Rail_PointerMoved"
	PointerPressed="Rail_PointerPressed"
	PointerReleased="Rail_PointerReleased"
	ToolTipService.ToolTip="{helpers:ResourceString Name=PulseTimeRail}"
	mc:Ignorable="d">

	<Grid Margin="0,12">
		<!--  Wide grab track: a comfortable 4K-safe target around the thin spine  -->
		<Rectangle
			Width="22"
			HorizontalAlignment="Right"
			Margin="0,0,1,0"
			Fill="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
			Opacity="0.35"
			RadiusX="11"
			RadiusY="11" />

		<!--  Spine  -->
		<Rectangle
			Width="3"
			HorizontalAlignment="Right"
			Margin="0,0,9,0"
			Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
			RadiusX="1.5"
			RadiusY="1.5" />

		<!--  Day ticks + labels (positioned in code)  -->
		<Canvas x:Name="TicksCanvas" />

		<!--  Current position: an accent bar riding the spine as the feed scrolls  -->
		<Border
			x:Name="ActiveThumb"
			Width="18"
			Height="6"
			HorizontalAlignment="Right"
			Margin="0,0,3,0"
			VerticalAlignment="Top"
			Background="{ThemeResource AccentFillColorDefaultBrush}"
			CornerRadius="3"
			IsHitTestVisible="False"
			Visibility="Collapsed" />

		<!--  Scrub indicator: the day under the pointer while dragging  -->
		<Border
			x:Name="ScrubBubble"
			HorizontalAlignment="Right"
			Margin="0,0,27,0"
			Padding="8,4"
			Background="{ThemeResource AccentFillColorDefaultBrush}"
			CornerRadius="6"
			IsHitTestVisible="False"
			Visibility="Collapsed">
			<TextBlock
				x:Name="ScrubText"
				FontFamily="Consolas"
				FontSize="12"
				Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
		</Border>
	</Grid>
</UserControl>
