<UserControl
	x:Class="Files.App.UserControls.Pulse.PulsePlayhead"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	IsHitTestVisible="False"
	IsTabStop="False"
	mc:Ignorable="d">

	<Grid>
		<!--  Played part of the strip, lifted a little (scaled from the left edge by the composition expression)  -->
		<Rectangle
			x:Name="PlayedOverlay"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Fill="#1FFFFFFF" />

		<!--  1 px playhead with a 1 px dark contrast seam on each side, so it stays visible over silver highs  -->
		<Rectangle
			x:Name="LineHalo"
			Width="3"
			Margin="-1,0,0,0"
			HorizontalAlignment="Left"
			VerticalAlignment="Stretch"
			Fill="#59000000" />
		<Rectangle
			x:Name="Line"
			Width="1"
			HorizontalAlignment="Left"
			VerticalAlignment="Stretch"
			Fill="#F5FFFFFF" />
	</Grid>
</UserControl>
